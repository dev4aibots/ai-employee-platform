# ---------------------------------------------------------------------------
# ai-employee-platform — environment contract
#
# Every variable the code reads is listed here, 1:1.
# The app refuses to start when a required variable is missing (see
# src/config.ts). Nothing in this file is a real secret.
# ---------------------------------------------------------------------------

# --- Tenant database (Postgres 15+ / Supabase) -----------------------------
# Production: your Supabase project URL, e.g. https://abcd1234.supabase.co
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_employees
# Supabase anon key. Safe to expose to the browser ONLY when RLS is enabled
# on every table, which db/policies.sql enforces.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
# Service role key. Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Credential vault ------------------------------------------------------
# 32+ random bytes, base64. Rotate by prepending a new key and keeping the old
# one so existing ciphertext still decrypts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=replace-with-32-byte-base64-key
# Comma-separated key versions, newest first, e.g. v2,v1
VAULT_KEY_VERSIONS=v1

# --- n8n dispatch ----------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_MASTER_WEBHOOK_PATH=webhook/master-webhook-endpoint
# Shared secret used to sign outbound dispatch requests (HMAC-SHA256).
N8N_SIGNING_SECRET=replace-with-shared-secret

# --- Inbound webhook verification -----------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_WEBHOOK_ID=replace-me
# Maximum accepted clock skew for signed requests, in seconds.
WEBHOOK_TOLERANCE_SECONDS=300

# --- Model gateway (LiteLLM) ----------------------------------------------
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-replace-with-your-key

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# When set, the test harness and demo seed this deterministic tenant pair.
DEMO_TENANT_A_EMAIL=ops@acme.test
DEMO_TENANT_B_EMAIL=ops@globex.test
